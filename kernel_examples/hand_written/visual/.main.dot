digraph "CFG for 'main' function" {
	label="CFG for 'main' function";

	Node0x5ab2a72b5e30 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#d6524470" fontname="Courier",label="{entry:\l|  %retval = alloca i32, align 4\l  %control_variable = alloca i32, align 4\l  %i = alloca i32, align 4\l  store i32 0, ptr %retval, align 4\l  store i32 0, ptr %control_variable, align 4\l  store i32 0, ptr %i, align 4\l  br label %for.cond\l}"];
	Node0x5ab2a72b5e30 -> Node0x5ab2a72b5ff0[tooltip="entry -> for.cond\nProbability 100.00%" ];
	Node0x5ab2a72b5ff0 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{for.cond:\l|  %0 = load i32, ptr %i, align 4\l  %cmp = icmp slt i32 %0, 10\l  br i1 %cmp, label %for.body, label %for.end\l|{<s0>T|<s1>F}}"];
	Node0x5ab2a72b5ff0:s0 -> Node0x5ab2a72b8000[tooltip="for.cond -> for.body\nProbability 96.88%" ];
	Node0x5ab2a72b5ff0:s1 -> Node0x5ab2a72b8c80[tooltip="for.cond -> for.end\nProbability 3.12%" ];
	Node0x5ab2a72b8000 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{for.body:\l|  %1 = load i32, ptr %i, align 4\l  %2 = load i32, ptr %control_variable, align 4\l  %add = add nsw i32 %2, %1\l  store i32 %add, ptr %control_variable, align 4\l  br label %for.inc\l}"];
	Node0x5ab2a72b8000 -> Node0x5ab2a72b8c20[tooltip="for.body -> for.inc\nProbability 100.00%" ];
	Node0x5ab2a72b8c20 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{for.inc:\l|  %3 = load i32, ptr %i, align 4\l  %inc = add nsw i32 %3, 1\l  store i32 %inc, ptr %i, align 4\l  br label %for.cond, !llvm.loop !6\l}"];
	Node0x5ab2a72b8c20 -> Node0x5ab2a72b5ff0[tooltip="for.inc -> for.cond\nProbability 100.00%" ];
	Node0x5ab2a72b8c80 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#d6524470" fontname="Courier",label="{for.end:\l|  %4 = load i32, ptr %control_variable, align 4\l  %cmp1 = icmp sgt i32 %4, 10\l  br i1 %cmp1, label %if.then, label %if.else\l|{<s0>T|<s1>F}}"];
	Node0x5ab2a72b8c80:s0 -> Node0x5ab2a72b8d00[tooltip="for.end -> if.then\nProbability 50.00%" ];
	Node0x5ab2a72b8c80:s1 -> Node0x5ab2a72ba240[tooltip="for.end -> if.else\nProbability 50.00%" ];
	Node0x5ab2a72b8d00 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#dc5d4a70" fontname="Courier",label="{if.then:\l|  store i32 0, ptr %retval, align 4\l  br label %return\l}"];
	Node0x5ab2a72b8d00 -> Node0x5ab2a72b90e0[tooltip="if.then -> return\nProbability 100.00%" ];
	Node0x5ab2a72ba240 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#dc5d4a70" fontname="Courier",label="{if.else:\l|  store i32 1, ptr %retval, align 4\l  br label %return\l}"];
	Node0x5ab2a72ba240 -> Node0x5ab2a72b90e0[tooltip="if.else -> return\nProbability 100.00%" ];
	Node0x5ab2a72b90e0 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#d6524470" fontname="Courier",label="{return:\l|  %5 = load i32, ptr %retval, align 4\l  ret i32 %5\l}"];
}
